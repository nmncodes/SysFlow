POSTGRES_DB=sysflow
POSTGRES_USER=sysflow
POSTGRES_PASSWORD=sysflow

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sysflow
JWT_SECRET=replace-with-output-of--openssl-rand-base64-32
JWT_EXPIRATION_MS=86400000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated. Add your deployed frontend's origin here in production, e.g.:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional comma-separated proxy IPs/CIDRs. Only set this when your reverse proxy
# overwrites or safely appends X-Forwarded-For (for example: 10.0.0.0/8,2001:db8::/32).
RATE_LIMIT_TRUSTED_PROXIES=

VITE_API_BASE_URL=http://localhost:8080/api
